<?xml version="1.0" encoding="utf-8"?>
<!--
    The dark ground the watch sits on, with the lift the design asks for: a radial
    gradient from the upper left rather than one flat tone, so the mark reads as lit
    rather than as printed. Off-centre because a light source that is dead centre looks
    like a mistake.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34.56"
                android:centerY="25.92"
                android:gradientRadius="102.6"
                android:startColor="#2A272E"
                android:endColor="#1C1B1F" />
        </aapt:attr>
    </path>
</vector>
