<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
        Its own drawing, not the foreground tinted. A themed icon is filled with one
        colour by the launcher, so a foreground that says anything through colour — here
        a pale case around an orange trace — says nothing at all once flattened.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
