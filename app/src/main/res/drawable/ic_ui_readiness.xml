<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        A dial with its needle up and to the right: this card is the one reading on the
        screen that is a verdict rather than a measurement, and it should not be mistaken
        for the pulse tile or the charts sitting on the same tab.

        Filled rather than stroked, like every other icon here. Both arcs are exact
        semicircles — chord equal to diameter — so the large-arc flag cannot be read two
        ways. The first attempt set that flag and got the arc longer than a semicircle,
        which wrapped it round the bottom and drew a broken circle instead of a dial.

        Proportions settled by rendering it rather than by arithmetic. A thicker band left
        no room inside, and a hub wider than the needle's base swallowed the needle and
        left a blob with a spike on it.
    -->

    <!-- The band: outer semicircle out, inner one back, centred on 12,16.5. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3,16.5A9,9 0 0,1 21,16.5L19,16.5A7,7 0 0,0 5,16.5Z" />

    <!-- The needle, from the hub at the dial's centre rather than from the chord. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M13,17.34L16.24,11.44 11,15.66Z" />

    <!-- The hub it turns on, narrower than the needle's base so the needle still reads. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M13.5,16.5a1.5,1.5 0 1,1 -3,0a1.5,1.5 0 1,1 3,0z" />
</vector>
