# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android
local.properties
*.apk
*.aab
*.keystore
# The debug signing key is checked in on purpose — see the comment in app/build.gradle.kts.
# Without a fixed key every CI build is signed differently and cannot be installed over
# the last one, which is what made every update wipe the app's settings.
!app/recmf-debug.keystore
.cxx/

# IDE
.idea/
*.iml
.kotlin/

# OS
.DS_Store

# Python leaves these next to any script that gets imported.
__pycache__/
*.pyc
