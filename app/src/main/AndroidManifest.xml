<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        neverForLocation keeps this off the location-permission path: reCMF only ever
        talks to a watch the user picked, and never infers where they are.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        For find-phone. The tone plays on the alarm stream so a silent phone is still
        findable, and the buzzing is for the case where even that is turned down.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Only for the weather forecast, and only for a place the user typed in. reCMF
        deliberately does not ask for location: a city name is enough for a watch face.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Coarse only, and requested at the moment the wearer presses "here" on the weather
        card — never at startup and never in the background. Typing a city still works
        with nothing granted, which is how this app worked before and remains the default.
        The Bluetooth scan above keeps neverForLocation: reCMF still does not infer where
        anyone is from a radio.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        For the weather following the wearer while the app is closed, and only when they
        have turned that on and granted "all the time" in system settings themselves.
        Android shows no dialog for this one, so it can only ever be a thing the wearer
        goes and does; with it ungranted the place is taken when the app is opened, and
        everything else still works.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      For installing an update reCMF downloaded itself. Declaring it is not enough: the
      user also has to allow reCMF to install apps, in system settings. Android shows its
      own confirmation for every install regardless — there is no silent path here short
      of owning the device.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Requested at runtime, and only after the user asks for background sync: without
        it Doze suspends the link and the watch silently stops syncing overnight, which
        is exactly the failure this app exists to avoid.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!--
        Read only, and asked for nowhere else in this file: reCMF has no heart-rate
        variability of its own to write. The watch it talks to reports one pulse a minute
        with no intervals behind it, so HRV can only ever arrive here from another device
        that measures it — which is the whole reason for reading it.
    -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />

        <!--
            Whatever handles speech, so the coach can tell whether there is anything to
            hand a question to. Declared by intent rather than by package: the recogniser
            is Google's on most phones and is not on all of them, and a button that can
            only apologise is worse than no button.
        -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>

        <!--
            Every app with a launcher icon, so the notification filter can list what is
            installed rather than only what has already notified. This is the narrow
            declaration Android asks for; QUERY_ALL_PACKAGES would also work and is both
            broader than the feature needs and restricted on the Play Store.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".ReCmfApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ReCMF">

        <!--
            adjustResize, declared rather than left to the platform's choice.

            Without it this phone panned the whole window on focus — watch bar and all —
            by less than the keyboard's height, so the box to type in stayed half covered
            while everything above it slid off the top. That pan then fought whatever
            padding the app applied: with an inset's worth of padding on top of the pan the
            box ended up near the top of the screen, and without it, under the keyboard.
            Six attempts, and none of them could win, because the window was moving
            underneath all of them.

            This turns the panning off and leaves the keyboard to the insets, which were
            correct all along: 921 pixels of it, reported to the app, ignored by nothing
            except the pan.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ReCMF"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect asks the app to justify its permissions, in-app. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.WatchService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!--
            Notification access is granted in system settings, not by a permission
            dialog, so the app has to send the user there.
        -->
        <service
            android:name=".notifications.NotificationRelay"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    
        <!-- Where the package installer reports back to; not for anything else to call. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:enabled="true"
            android:exported="false" />

</application>
</manifest>
